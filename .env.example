DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=offlab
POSTGRES_USER=offlab
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_SSLMODE=prefer

# Prisma Postgres: conexão direta para migrações e pool para a aplicação.
# Deixe em branco para usar POSTGRES_* localmente.
DATABASE_URL=
DATABASE_URL_POOLED=
# Opcional: tem prioridade sobre DATABASE_URL em migrações diretas.
DIRECT_URL=

# Domínios próprios podem ser acrescentados no painel da Vercel.
DJANGO_CSRF_TRUSTED_ORIGINS=
