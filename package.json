{
  "name": "off-nutrition-lab-prototipo",
  "version": "1.0.0",
  "private": true,
  "description": "Protótipo local de pedidos e estoque da OFF Nutrition Lab",
  "scripts": {
    "test": "npm run test:unit && node scripts/run-checks.mjs",
